}
.nav-links a {
  position: relative;
  transition: color 0.3s ease;
}

.nav-links a::after {
  content: "";
  position: absolute;

  left: 0;
  bottom: -6px;

  width: 0;
  height: 1px;

  background: #a66f72;

  transition: width 0.3s ease;
}

.nav-links a:hover::after {
