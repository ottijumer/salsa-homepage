  }


  /* HERO */

  .hero h1 {
  font-size: clamp(2.7rem, 12vw, 3.5rem);
  line-height: 1;
  }

  .hero {
    grid-template-columns: 1fr;
  }

  .hero-text {
    min-height: 70vh;
