  }


  /* CONTACT */

  .contact {
    padding: 90px 25px;
  }

  .contact-links {
    flex-direction: column;
    align-items: flex-start;
  }


  /* FOOTER */

  .footer-inner {
    padding: 30px 25px;

    flex-direction: column;
    align-items: flex-start;

    gap: 20px;
  }

}
</style>