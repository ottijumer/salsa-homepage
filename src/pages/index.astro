  }

  .about-content {
    padding: 70px 25px 90px;
  }


  /* CLASSES */

  .classes {
    padding: 90px 25px;
  }

  .class-grid {
    grid-template-columns: 1fr;
  }

  .class-number {
    margin-bottom: 25px;
  }


  /* SCHEDULE */

  .schedule {
    padding: 90px 25px;
  }

  .schedule-item {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .schedule-time {
    text-align: left;
  }

  .pricing {
    grid-template-columns: 1fr;
  }


  /* GALLERY */

  .gallery {
    padding: 90px 25px;
  }

  .gallery-grid {
    grid-template-columns: 1fr;
  }

  .gallery-wide {
    grid-column: span 1;
  }

  .gallery-large,
  .gallery-placeholder {
