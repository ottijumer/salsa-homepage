        </div>

      </section>



      <!-- CLASSES -->
      <section class="classes" id="classes">

        <div class="section-heading">

          <p class="eyebrow">
            Classes
          </p>

          <h2>
            Find your way to move.
          </h2>

        </div>


        <div class="class-grid">

          <article class="class-card">

            <p class="class-number">
              01
            </p>

            <h3>
              Salsa Solo Basic
            </h3>

            <p>
              Perfect for beginners who want to build confidence,
              improve  movement and learn fundamental Salsa technique.
            </p>

            <span>
              Beginner
            </span>

          </article>


          <article class="class-card">

            <p class="class-number">
              02
            </p>

            <h3>
              Salsa Solo Intermediate
            </h3>

            <p>
              Work on styling, musicality, coordination and more advanced
              movement combinations.
            </p>

            <span>
              Intermediate
            </span>

          </article>


          <article class="class-card">

            <p class="class-number">
              03
            </p>

            <h3>
              Workshops & Private Classes
            </h3>

            <p>
              Individual training, special workshops and tailored sessions
              for dancers who want to go deeper.
            </p>

            <span>
              All levels
            </span>

          </article>

        </div>

      </section>
	  <!-- SCHEDULE -->
		<section class="schedule" id="schedule">

  <div class="schedule-heading">
    <p class="eyebrow">Weekly Schedule</p>

    <h2>
      Join me on
      <span>Tuesdays.</span>
    </h2>

    <p class="schedule-intro">
      Salsa Solo classes in Linz — taught On2 and open to everyone
      who wants to improve technique, styling and confidence.
    </p>
  </div>


  <div class="schedule-list">

    <div class="schedule-item">

      <div class="schedule-day">
        Tuesday
      </div>

      <div class="schedule-class">
        <h3>Salsa Solo Basic</h3>
        <p>Beginner level</p>
      </div>

      <div class="schedule-time">
        19:30 – 20:15
      </div>

    </div>


    <div class="schedule-item">

      <div class="schedule-day">
        Tuesday
      </div>

      <div class="schedule-class">
        <h3>Salsa Solo Intermediate</h3>
        <p>Intermediate level</p>
      </div>

      <div class="schedule-time">
        20:15 – 21:00
      </div>

    </div>

  </div>


  <div class="pricing">

    <div>
      <p class="pricing-label">Monthly</p>
      <h3>€90</h3>
      <p>4 sessions · 1 class per week</p>
    </div>

    <div>
      <p class="pricing-label">2 Months</p>
      <h3>€160</h3>
      <p>Save money and secure your spot</p>
    </div>

    <div>
      <p class="pricing-label">Special Bonus</p>
      <h3>2 Classes</h3>
      <p>
        Sign up for one class and join both Tuesday sessions.
      </p>
    </div>

  </div>
</section>
  <!-- GALLERY -->
  <section class="gallery" id="gallery">

  <div class="gallery-heading">
    <p class="eyebrow">Gallery</p>

    <h2>
      Moments in
      <span>motion.</span>
    </h2>
  </div>

  <div class="gallery-grid">

    <div class="gallery-placeholder gallery-large">
      <span>Photo coming soon</span>
    </div>

    <div class="gallery-placeholder">
      <span>Photo coming soon</span>
    </div>

    <div class="gallery-placeholder">
      <span>Photo coming soon</span>
    </div>

    <div class="gallery-placeholder gallery-wide">
      <span>Photo coming soon</span>
    </div>

  </div>



</section>
<!-- CONTACT -->
<section class="contact" id="contact">

  <div class="contact-content">

    <p class="eyebrow">Contact</p>

    <h2>
      Ready to
      <span>dance?</span>
    </h2>

    <p class="contact-text">
      Want to join a class, book a private session or invite me
      for a workshop? Feel free to get in touch.
    </p>

    <div class="contact-links">

      <a href="mailto:niushamehranshad@gmail.com">
        Email me →
      </a>

      <a
        href="https://www.instagram.com/niushamehranshad/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Instagram →
      </a>

    </div>

  </div>

</section>

<footer>
  <div class="footer-inner">

    <p>© 2026 Niusha Salsa</p>

    <div class="footer-links">
      <a href="/impressum">Impressum</a>
      <a href="/datenschutz">Datenschutz</a>
    </div>

  </div>
</footer>
    </main>
<script>
  const menuButton = document.querySelector("#menu-button");
  const navLinks = document.querySelector("#nav-links");

  if (menuButton && navLinks) {
    menuButton.addEventListener("click", () => {
      navLinks.classList.toggle("open");

      const isOpen = navLinks.classList.contains("open");

      menuButton.setAttribute("aria-expanded", String(isOpen));
      menuButton.textContent = isOpen ? "✕" : "☰";
    });

    navLinks.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        navLinks.classList.remove("open");
        menuButton.setAttribute("aria-expanded", "false");
        menuButton.textContent = "☰";
      });
    });
  }
</script>
  </body>
</html>



<style>

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  html {
    scroll-behavior: smooth;
  }

  html,
  body {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  }


  body {
    font-family: Arial, sans-serif;
    background: #f4eee8;
    color: #211d1b;
  }


  /* NAVIGATION */

  header {
    width: 100%;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 10;
  }


  nav {
    max-width: 1300px;
    margin: 0 auto;
    padding: 28px 50px;

    display: flex;
    justify-content: space-between;
    align-items: center;
  }


  .logo {
    font-size: 1.2rem;
    font-weight: bold;
    letter-spacing: 0.04em;
  }


  .nav-links {
    display: flex;
    gap: 32px;
  }


  .nav-links a {
    color: #f4eee8;
    text-decoration: none;
    font-size: 0.95rem;
  }
  .menu-button {
  display: none;
  background: none;
  border: none;
  color: #211d1b;
  font-size: 1.8rem;
  cursor: pointer;
  }



  /* HERO */

  .hero {
    min-height: 100vh;

    display: grid;
    grid-template-columns: 1fr 1fr;
  }


  .hero-text {
    display: flex;
    flex-direction: column;
    justify-content: center;

    padding: 130px 8vw 80px;
  }


  .eyebrow {
    font-size: 0.8rem;

    text-transform: uppercase;
    letter-spacing: 0.22em;

    margin-bottom: 28px;
  }


  h1 {
    font-size: clamp(3.5rem, 7vw, 7rem);

    line-height: 0.95;

    font-weight: 500;

    max-width: 700px;
  }


  h1 span {
    color: #a66f72;
  }


  .description {
    margin-top: 30px;
    margin-bottom: 35px;

    font-size: 1.15rem;

    line-height: 1.6;
  }


  .button {
  width: fit-content;
  background: #211d1b;
  color: white;
  text-decoration: none;
  padding: 15px 26px;
  border-radius: 999px;

  transition:
    background 0.3s ease,
    transform 0.3s ease;
  }

.button:hover {
  background: #a66f72;
  transform: translateY(-2px);
  }


  .hero-image {
    height: 100vh;

    overflow: hidden;
  }


  .hero-image img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    object-position: center 30%;
  }



  /* ABOUT */

  .about {
    min-height: 90vh;

    display: grid;

    grid-template-columns: 0.9fr 1.1fr;

    background: #f4eee8;
  }


  .about-image {
    overflow: hidden;

    margin: 80px;

    margin-right: 0;
  }


  .about-image img {
    width: 100%;
    height: 100%;

    min-height: 600px;

    object-fit: cover;

    object-position: center 25%;
  }


  .about-content {
    display: flex;

    flex-direction: column;

    justify-content: center;

    padding: 100px 10vw;
  }


  .about-content h2 {
    font-size: clamp(2.8rem, 5vw, 5.5rem);

    line-height: 1;

    font-weight: 500;

    margin-bottom: 40px;
  }


  .about-content h2 span {
    color: #a66f72;
  }


  .about-content > p:not(.eyebrow) {
    max-width: 550px;

    font-size: 1.05rem;

    line-height: 1.8;

    margin-bottom: 20px;
  }


  .text-link {
    margin-top: 25px;

    width: fit-content;

    color: #211d1b;

    text-decoration: none;

    font-weight: bold;

    border-bottom: 1px solid #211d1b;

    padding-bottom: 4px;
  }



  /* CLASSES */

  .classes {
    padding: 120px 8vw;

    background: #211d1b;

    color: #f4eee8;

    scroll-margin-top: 20px;
  }


  .section-heading {
    max-width: 1300px;

    margin: 0 auto 70px;
  }


  .section-heading h2 {
    font-size: clamp(2.8rem, 5vw, 5rem);

    font-weight: 500;

    max-width: 700px;
  }


  .classes .eyebrow {
    color: #c89a9d;
  }


  .class-grid {
    max-width: 1300px;

    margin: 0 auto;

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 20px;
  }


  .class-card {
    border-top: 1px solid #655d59;

    padding: 30px 10px 40px;
  }


  .class-number {
    color: #c89a9d;

    margin-bottom: 50px;
  }


  .class-card h3 {
    font-size: 1.7rem;

    margin-bottom: 20px;

    font-weight: 500;
  }


  .class-card p {
    line-height: 1.7;

    max-width: 350px;
  }


  .class-card span {
    display: inline-block;

    margin-top: 30px;

    font-size: 0.85rem;

    text-transform: uppercase;

    letter-spacing: 0.12em;

    color: #c89a9d;
  }


/* SCHEDULE */

.schedule {
  padding: 120px 8vw;
  background: #f4eee8;
  color: #211d1b;
  scroll-margin-top: 20px;
}

.schedule-heading {
